        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F6F0E8;strokeColor=#000000;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=1;" value="Reduce redundancia&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Un mismo dato se almacena una sola vez cuando corresponde.&lt;/span&gt;" vertex="1">
