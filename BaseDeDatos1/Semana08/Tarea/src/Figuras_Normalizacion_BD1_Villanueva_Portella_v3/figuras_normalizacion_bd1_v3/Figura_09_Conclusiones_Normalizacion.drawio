        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EEF3EC;strokeColor=#58704C;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=1;" value="Evita inconsistencias&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Los cambios se realizan en un lugar definido y no en múltiples copias.&lt;/span&gt;" vertex="1">
