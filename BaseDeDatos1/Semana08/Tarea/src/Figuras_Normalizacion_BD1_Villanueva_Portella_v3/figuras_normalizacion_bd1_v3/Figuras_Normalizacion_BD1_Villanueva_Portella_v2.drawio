;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1EDF5;strokeColor=#6E587A;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="620" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="Figura_09_Conclusiones_Normalizacion" name="Figura_09_Conclusiones_Normalizacion"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titlebar" value="" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#5C6B4F;strokeColor=#5C6B4F;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="1240" height="56" as="geometry" /></mxCell><mxCell id="title" value="Beneficios de la normalización" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontFamily=Arial;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="48" width="1200" height="38" as="geometry" /></mxCell><mxCell id="b1" value="Reduce redundancia&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Un mismo dato se almacena una sola vez cuando corresponde.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F6F0E8;strokeColor=#000000;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="300" width="300" height="170" as="geometry" /></mxCell><mxCell id="b2" value="Evita inconsistencias&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Los cambios se realizan en un lugar definido y no en múltiples copias.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EEF3EC;strokeColor=#58704C;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="300" height="170" as="geometry" /></mxCell><mxCell id="b3" value="Facilita mantenimiento&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Las tablas representan conceptos más claros y fáciles de modificar.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F6F1E1;strokeColor=#8D6E1E;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="300" width="300" height="170" as="geometry" /></mxCell><mxCell id="b4" value="Mejora integridad&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Las claves y relaciones ayudan a mantener datos coherentes.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1EDF5;strokeColor=#6E587A;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="300" width="300" height="170" as="geometry" /></mxCell><mxCell id="foot" value="Normalizar no significa dividir datos sin criterio: significa estructurarlos según sus dependencias." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="1000" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>