><mxCell id="c3" value="SECCIÓN&amp;lt;br&amp;gt;&amp;lt;hr&amp;gt;codigo_seccion&amp;lt;br&amp;gt;periodo" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#005596;strokeWidth=2;fontColor=#333333;fontFamily=Arial;fontSize=15;" vertex="1" parent="1"><mxGeometry x="870" y="155" width="220" height="170" as="geometry" /></mxCell><mxCell id="r" value="Reglas de negocio" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#005596;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="1040" height="45" as="geometry" /></mxCell><mxCell id="r1" value="1. Un alumno puede matricularse en varias secciones." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF2F8;strokeColor=#005596;strokeWidth=1;fontColor=#333333;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="465" width="940" height="55" as="geometry" /></mxCell><mxCell id="r2" value="2. Una sección corresponde a una asignatura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#D7DEE7;strokeWidth=1;fontColor=#333333;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="535" width="940" height="55" as="geometry" /></mxCell><mxCell id="r3" value="3. Un docente puede enseñar una o varias secciones." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FBEAEC;strokeColor=#C9252C;strokeWidth=1;fontColor=#333333;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="605" width="940" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="13_Caso_MER_Completo" name="13_Caso_MER_Completo"><mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0"><roo