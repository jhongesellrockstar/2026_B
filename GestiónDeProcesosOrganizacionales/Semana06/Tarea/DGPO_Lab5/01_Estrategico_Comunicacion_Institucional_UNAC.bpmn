        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="219" width="225" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_T4_di" bpmnElement="CI_T4">
        <dc:Bounds x="930" y="135" width="175" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920" y="219" width="215" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_T5_di" bpmnElement="CI_T5">
        <dc:Bounds x="1160" y="135" width="185" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1150" y="219" width="225" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_T6_di" bpmnElement="CI_T6">
        <dc:Bounds x="1160" y="225" width="185" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1150" y="279" width="225" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_E_di" bpmnElement="CI_E">
        <dc:Bounds x="1390" y="160" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1380" y="200" width="76" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="CI_F1_di" bpmnElement="CI_F1">
        <di:waypoint x="161" y="178" />
        <di:waypoint x="210" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CI_F2_di" bpmnElement="CI_F2">
        <di:waypoint x="390" y="175" />
        <di:waypoint x="420" y="175" />
        <di:waypoint x="420" y="385" />
        <di:waypoint x="450" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CI_F3_di" bpmnElement="CI_F3">
        <di:waypoint x="630" y="385" />
        <di:waypoint x="660" y="385" />
        <di:waypoint x="660" y="175" />
        <di:waypoint x="690" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CI_F4_di" bpmnElement="CI_F4">
        <di:waypoint x="875" y="175" />
        <di:waypoint x="930" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CI_F5_di" bpmnElement="CI_F5">
        <di:waypoint x="1105" y="175" />
        <di:waypoint x="1160" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CI_F6_di" bpmnElement="CI_F6">
        <di:waypoint x="1252" y="215" />
        <di:waypoint x="1252" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CI_F7_di" bpmnElement="CI_F7">
        <di:waypoint x="1345" y="250" />
        <di:waypoint x="1370" y="250" />
        <di:waypoint x="1370" y="178" />
        <di:waypoint x="1390" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>