<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_Comunicacion" targetNamespace="http://unac.edu.pe/dgpo/lab5">
  <process id="Proc_Comunicacion" name="Estrategico — Gestión de Comunicación Institucional" isExecutable="false">
    <laneSet id="LaneSet_Proc_Comunicacion">
      <lane id="CI_L1" name="OCII / Comité de Publicaciones y Marketing">
        <flowNodeRef>CI_S</flowNodeRef>
        <flowNodeRef>CI_T1</flowNodeRef>
        <flowNodeRef>CI_T3</flowNodeRef>
        <flowNodeRef>CI_T4</flowNodeRef>
        <flowNodeRef>CI_T5</flowNodeRef>
        <flowNodeRef>CI_T6</flowNodeRef>
        <flowNodeRef>CI_E</flowNodeRef>
      </lane>
      <lane id="CI_L2" name="Consejo Universitario / Consejo de Facultad / Escuela de Posgrado">
        <flowNodeRef>CI_T2</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="CI_S" name="Inicio">
      <outgoing>CI_F1</outgoing>
    </startEvent>
    <userTask id="CI_T1" name="Elaborar Plan/Cronograma anual de eventos y comunicación">
      <incoming>CI_F1</incoming>
      <outgoing>CI_F2</outgoing>
    </userTask>
    <userTask id="CI_T2" name="Revisar y aprobar Plan/Cronograma anual">
      <incoming>CI_F2</incoming>
      <outgoing>CI_F3</outgoing>
    </userTask>
    <userTask id="CI_T3" name="Gestionar adquisición de materiales y servicios logísticos">
      <incoming>CI_F3</incoming>
      <outgoing>CI_F4</outgoing>
    </userTask>
    <userTask id="CI_T4" name="Elaborar piezas gráficas y material">
      <incoming>CI_F4</incoming>
      <outgoing>CI_F5</outgoing>
    </userTask>
    <userTask id="CI_T5" name="Ejecutar evento y realizar cobertura fotográfica/audiovisual">
      <incoming>CI_F5</incoming>
      <outgoing>CI_F6</outgoing>
    </userTask>
    <userTask id="CI_T6" name="Publicar en página web y redes sociales">
      <incoming>CI_F6</incoming>
      <outgoing>CI_F7</outgoing>
    </userTask>
    <endEvent id="CI_E" name="Fin">
      <incoming>CI_F7</incoming>
    </endEvent>
    <sequenceFlow id="CI_F1" sourceRef="CI_S" targetRef="CI_T1" />
    <sequenceFlow id="CI_F2" sourceRef="CI_T1" targetRef="CI_T2" />
    <sequenceFlow id="CI_F3" sourceRef="CI_T2" targetRef="CI_T3" />
    <sequenceFlow id="CI_F4" sourceRef="CI_T3" targetRef="CI_T4" />
    <sequenceFlow id="CI_F5" sourceRef="CI_T4" targetRef="CI_T5" />
    <sequenceFlow id="CI_F6" sourceRef="CI_T5" targetRef="CI_T6" />
    <sequenceFlow id="CI_F7" sourceRef="CI_T6" targetRef="CI_E" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_Comunicacion">
    <bpmndi:BPMNPlane id="Plane_Proc_Comunicacion" bpmnElement="Proc_Comunicacion">
      <bpmndi:BPMNShape id="CI_L1_di" bpmnElement="CI_L1" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1400" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_L2_di" bpmnElement="CI_L2" isHorizontal="true">
        <dc:Bounds x="80" y="290" width="1400" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_S_di" bpmnElement="CI_S">
        <dc:Bounds x="125" y="160" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="200" width="76" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_T1_di" bpmnElement="CI_T1">
        <dc:Bounds x="210" y="135" width="180" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="200" y="219" width="220" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_T2_di" bpmnElement="CI_T2">
        <dc:Bounds x="450" y="345" width="180" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="429" width="220" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CI_T3_di" bpmnElement="CI_T3">
