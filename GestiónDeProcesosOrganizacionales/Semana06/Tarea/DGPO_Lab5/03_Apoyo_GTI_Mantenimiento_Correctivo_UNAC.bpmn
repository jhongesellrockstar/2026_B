        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_E_di" bpmnElement="G_E">
        <dc:Bounds x="1495" y="400" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1485" y="440" width="76" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
