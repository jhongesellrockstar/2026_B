<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_GTI" targetNamespace="http://unac.edu.pe/dgpo/lab5">
  <process id="Proc_GTI" name="Apoyo — GTI: mantenimiento correctivo" isExecutable="false">
    <laneSet id="LaneSet_Proc_GTI">
      <lane id="G_L1" name="Área usuaria">
        <flowNodeRef>G_S</flowNodeRef>
        <flowNodeRef>G_T1</flowNodeRef>
      </lane>
      <lane id="G_L2" name="OTI / CTIC de Facultad">
        <flowNodeRef>G_T2</flowNodeRef>
        <flowNodeRef>G_T3</flowNodeRef>
        <flowNodeRef>G_GW1</flowNodeRef>
        <flowNodeRef>G_T4</flowNodeRef>
        <flowNodeRef>G_T5</flowNodeRef>
        <flowNodeRef>G_T6</flowNodeRef>
        <flowNodeRef>G_GW2</flowNodeRef>
        <flowNodeRef>G_T7</flowNodeRef>
        <flowNodeRef>G_E</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="G_S" name="Falla detectada">
      <outgoing>G_F1</outgoing>
    </startEvent>
    <userTask id="G_T1" name="Reportar falla">
      <incoming>G_F1</incoming>
      <outgoing>G_F2</outgoing>
    </userTask>
    <userTask id="G_T2" name="Recibir reporte de falla">
      <incoming>G_F2</incoming>
      <outgoing>G_F3</outgoing>
    </userTask>
    <userTask id="G_T3" name="Evaluar falla">
      <incoming>G_F3</incoming>
      <outgoing>G_F4</outgoing>
    </userTask>
    <exclusiveGateway id="G_GW1" name="¿Tipo de atención?" gatewayDirection="Diverging">
      <incoming>G_F4</incoming>
      <outgoing>G_F5</outgoing>
      <outgoing>G_F6</outgoing>
      <outgoing>G_F7</outgoing>
    </exclusiveGateway>
    <userTask id="G_T4" name="Realizar reparación interna">
      <incoming>G_F5</incoming>
      <outgoing>G_F8</outgoing>
    </userTask>
    <userTask id="G_T5" name="Registrar y gestionar garantía">
      <incoming>G_F6</incoming>
      <outgoing>G_F9</outgoing>
    </userTask>
    <userTask id="G_T6" name="Registrar necesidad de repuesto">
      <incoming>G_F7</incoming>
      <outgoing>G_F10</outgoing>
    </userTask>
    <exclusiveGateway id="G_GW2" name="Continuar" gatewayDirection="Converging">
      <incoming>G_F8</incoming>
      <incoming>G_F9</incoming>
      <incoming>G_F10</incoming>
      <outgoing>G_F11</outgoing>
    </exclusiveGateway>
    <userTask id="G_T7" name="Emitir informe de mantenimiento correctivo">
      <incoming>G_F11</incoming>
      <outgoing>G_F12</outgoing>
    </userTask>
    <endEvent id="G_E" name="Fin">
      <incoming>G_F12</incoming>
    </endEvent>
    <sequenceFlow id="G_F1" sourceRef="G_S" targetRef="G_T1" />
    <sequenceFlow id="G_F2" sourceRef="G_T1" targetRef="G_T2" />
    <sequenceFlow id="G_F3" sourceRef="G_T2" targetRef="G_T3" />
    <sequenceFlow id="G_F4" sourceRef="G_T3" targetRef="G_GW1" />
    <sequenceFlow id="G_F5" sourceRef="G_GW1" targetRef="G_T4" name="Interna" />
    <sequenceFlow id="G_F6" sourceRef="G_GW1" targetRef="G_T5" name="Garantía" />
    <sequenceFlow id="G_F7" sourceRef="G_GW1" targetRef="G_T6" name="Repuesto" />
    <sequenceFlow id="G_F8" sourceRef="G_T4" targetRef="G_GW2" />
    <sequenceFlow id="G_F9" sourceRef="G_T5" targetRef="G_GW2" />
    <sequenceFlow id="G_F10" sourceRef="G_T6" targetRef="G_GW2" />
    <sequenceFlow id="G_F11" sourceRef="G_GW2" targetRef="G_T7" />
    <sequenceFlow id="G_F12" sourceRef="G_T7" targetRef="G_E" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_GTI">
    <bpmndi:BPMNPlane id="Plane_Proc_GTI" bpmnElement="Proc_GTI">
      <bpmndi:BPMNShape id="G_L1_di" bpmnElement="G_L1" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1450" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_L2_di" bpmnElement="G_L2" isHorizontal="true">
