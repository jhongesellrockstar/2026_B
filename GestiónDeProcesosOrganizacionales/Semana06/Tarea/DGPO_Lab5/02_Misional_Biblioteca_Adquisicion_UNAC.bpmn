<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_Biblioteca" targetNamespace="http://unac.edu.pe/dgpo/lab5">
  <process id="Proc_Biblioteca" name="Misional — Biblioteca: adquisición de material bibliográfico" isExecutable="false">
    <laneSet id="LaneSet_Proc_Biblioteca">
      <lane id="B_L1" name="Jefe/a de la UBCBLL">
        <flowNodeRef>B_S</flowNodeRef>
        <flowNodeRef>B_T1</flowNodeRef>
      </lane>
      <lane id="B_L2" name="Área de Procesos Técnicos de la UBCBLL">
        <flowNodeRef>B_T2</flowNodeRef>
      </lane>
      <lane id="B_L3" name="Dirección de Asuntos Académicos">
        <flowNodeRef>B_T3</flowNodeRef>
      </lane>
      <lane id="B_L4" name="Vicerrectorado Académico">
        <flowNodeRef>B_T4</flowNodeRef>
        <flowNodeRef>B_E</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="B_S" name="Inicio">
      <outgoing>B_F1</outgoing>
    </startEvent>
    <userTask id="B_T1" name="Revisar requerimiento de material bibliográfico">
      <incoming>B_F1</incoming>
      <outgoing>B_F2</outgoing>
    </userTask>
    <userTask id="B_T2" name="Evaluar y seleccionar requerimiento de adquisición">
      <incoming>B_F2</incoming>
      <outgoing>B_F3</outgoing>
    </userTask>
    <userTask id="B_T3" name="Aprobar cuadro para adquisición de material bibliográfico">
      <incoming>B_F3</incoming>
      <outgoing>B_F4</outgoing>
    </userTask>
    <userTask id="B_T4" name="Gestionar adquisición de material bibliográfico">
      <incoming>B_F4</incoming>
      <outgoing>B_F5</outgoing>
    </userTask>
    <endEvent id="B_E" name="Fin">
      <incoming>B_F5</incoming>
    </endEvent>
    <sequenceFlow id="B_F1" sourceRef="B_S" targetRef="B_T1" />
    <sequenceFlow id="B_F2" sourceRef="B_T1" targetRef="B_T2" />
    <sequenceFlow id="B_F3" sourceRef="B_T2" targetRef="B_T3" />
    <sequenceFlow id="B_F4" sourceRef="B_T3" targetRef="B_T4" />
    <sequenceFlow id="B_F5" sourceRef="B_T4" targetRef="B_E" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_Biblioteca">
