<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_SolicitudVacaciones"
 targetNamespace="http://example.org/bpmn">
  <process id="Proceso_Solicitud_Vacaciones" name="Proceso de Solicitud de Vacaciones" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Empleado" name="Empleado">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_IngresarSolicitud</flowNodeRef>
        <flowNodeRef>Task_NotificarRechazo</flowNodeRef>
        <flowNodeRef>EndEvent_Rechazado</flowNodeRef>
      </lane>
      <lane id="Lane_Supervisor" name="Supervisor">
        <flowNodeRef>Task_RevisarAprobar</flowNodeRef>
        <flowNodeRef>Gateway_Aprobada</flowNodeRef>
      </lane>
      <lane id="Lane_ORH" name="ORH">
        <flowNodeRef>Task_TramiteAdministrativo</flowNodeRef>
        <flowNodeRef>EndEvent_Aprobado</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Solicitud iniciada"/>
    <userTask id="Task_IngresarSolicitud" name="Ingresar solicitud de vacaciones"/>
    <userTask id="Task_RevisarAprobar" name="Revisar y aprobar solicitud de vacaciones"/>
    <exclusiveGateway id="Gateway_Aprobada" name="¿Solicitud aprobada?"/>
    <userTask id="Task_NotificarRechazo" name="Notificar rechazo"/>
    <task id="Task_TramiteAdministrativo" name="Trámite administrativo"/>
    <endEvent id="EndEvent_Rechazado" name="Solicitud rechazada"/>
    <endEvent id="EndEvent_Aprobado" name="Vacaciones tramitadas"/>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_IngresarSolicitud"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_IngresarSolicitud" targetRef="Task_RevisarAprobar"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_RevisarAprobar" targetRef="Gateway_Aprobada"/>
    <sequenceFlow id="Flow_Si" name="Sí" sourceRef="Gateway_Aprobada" targetRef="Task_TramiteAdministrativo"/>
    <sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Aprobada" targetRef="Task_NotificarRechazo"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_NotificarRechazo" targetRef="EndEvent_Rechazado"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_TramiteAdministrativo" targetRef="EndEvent_Aprobado"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Proceso_Solicitud_Vacaciones">
      <bpmndi:BPMNShape id="Lane_Empleado_di" bpmnElement="Lane_Empleado" isHorizontal="true"><dc:Bounds x="120" y="120" width="900" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true"><dc:Bounds x="120" y="300" width="900" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ORH_di" bpmnElement="Lane_ORH" isHorizontal="true"><dc:Bounds x="120" y="480" width="900" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="165" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IngresarSolicitud_di" bpmnElement="Task_IngresarSolicitud"><dc:Bounds x="250" y="165" width="150" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevisarAprobar_di" bpmnElement="Task_RevisarAprobar"><dc:Bounds x="445" y="345" width="170" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Aprobada_di" bpmnElement="Gateway_Aprobada" isMarkerVisible="true"><dc:Bounds x="670" y="365" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotificarRechazo_di" bpmnElement="Task_NotificarRechazo"><dc:Bounds x="790" y="165" width="145" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TramiteAdministrativo_di" bpmnElement="Task_TramiteAdministrativo"><dc:Bounds x="790" y="525" width="160" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rechazado_di" bpmnElement="EndEvent_Rechazado"><dc:Bounds x="970" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Aprobado_di" bpmnElement="EndEvent_Aprobado"><dc:Bounds x="970" y="552" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="201" y="208"/><di:waypoint x="250" y="208"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="400" y="210"/><di:waypoint x="420" y="210"/><di:waypoint x="420" y="390"/><di:waypoint x="445" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="615" y="390"/><di:waypoint x="670" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No"><di:waypoint x="695" y="365"/><di:waypoint x="695" y="210"/><di:waypoint x="790" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Si_di" bpmnElement="Flow_Si"><di:waypoint x="695" y="415"/><di:waypoint x="695" y="570"/><di:waypoint x="790" y="570"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="935" y="210"/><di:waypoint x="970" y="208"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="950" y="570"/><di:waypoint x="970" y="570"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
